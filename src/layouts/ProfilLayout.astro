---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  basePath?: string;
}

const {
  title = "Profil Perusahaan — Sarjana Komputer Indonesia",
  description = "Profil resmi CV. Sarjana Komputer Indonesia — Mitra terdepan transformasi digital.",
  canonical = "https://profil.sarjanakomputer.id/",
  ogImage = "https://sarjanakomputer.id/images/logo.png",
  basePath = "..",
} = Astro.props;

const profilHome = "https://profil.sarjanakomputer.id/";
const mainSite = "https://sarjanakomputer.id/";

const navLinks = [
  { name: 'Tentang Kami', href: '#tentang', icon: 'bi-info-circle' },
  { name: 'Visi Misi', href: '#visi-misi', icon: 'bi-target' },
  { name: 'Tim', href: '#tim', icon: 'bi-people' },
  { name: 'Legalitas', href: '#legal', icon: 'bi-file-earmark-check' },
  { name: 'Struktur', href: '#struktur', icon: 'bi-diagram-3' },
  { name: 'Kontak', href: '#kontak', icon: 'bi-envelope' },
];
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>

  <!-- SEO -->
  <meta name="robots" content="index, follow">
  <meta name="geo.region" content="ID">
  
  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>

  <!-- GA4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-9JTNZXFB0E"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag("js",new Date());gtag("config","G-9JTNZXFB0E");</script>

  <link rel="shortcut icon" href="/images/logo.png" type="image/png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href={`${basePath}/css/subdomain.min.css`}>
  <link rel="stylesheet" href={`${basePath}/css/homepage.css`}>

  <style is:global>
    :root { 
      --profil-primary: #312E5F; 
      --primary: #312E5F; 
      --secondary: #E3386A; 
      --dark: #1A1838; 
    }
    
    .profil-nav {
      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(15px);
      border-bottom: 2px solid var(--primary);
      position: sticky;
      top: 0;
      z-index: 1000;
      padding: 0.7rem 0;
    }
    .profil-nav .nav-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .profil-nav .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
    }
    .profil-nav .brand img { width: 32px; height: 32px; border-radius: 6px; }
    .profil-nav .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
    .profil-nav .brand-name { 
      color: var(--dark); 
      font-family: 'Plus Jakarta Sans', sans-serif; 
      font-weight: 800; 
      font-size: 0.95rem; 
    }
    .profil-nav .brand-sub { 
      color: var(--secondary); 
      font-size: 0.6rem; 
      font-weight: 800; 
      text-transform: uppercase; 
      letter-spacing: 2px; 
    }
    
    .profil-nav .menu { display: flex; gap: 0.2rem; list-style: none; margin: 0; padding: 0; }
    .profil-nav .menu a {
      color: var(--gray-600);
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.4rem 0.7rem;
      border-radius: 8px;
      transition: 0.2s;
      text-decoration: none;
    }
    .profil-nav .menu a:hover { color: var(--primary); background: rgba(49,46,95,0.05); }
    
    .btn-main-nav {
      background: var(--dark);
      color: #fff !important;
      padding: 0.45rem 1rem;
      border-radius: 10px;
      font-size: 0.78rem;
      font-weight: 700;
      margin-left: 0.5rem;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: 0.3s;
    }
    .btn-main-nav:hover { background: var(--primary); transform: translateY(-1.5px); }

    .profil-hamburger {
      display: none;
      background: none;
      border: none;
      color: var(--dark);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .profil-footer {
      background: #f1f5f9;
      color: var(--gray-500);
      padding: 3rem 1.5rem;
      text-align: center;
      border-top: 1px solid #e2e8f0;
    }
    .profil-footer a { color: var(--primary); text-decoration: none; font-weight: 600; }
    
    @media (max-width: 991px) {
      .profil-nav .menu { display: none; }
      .profil-hamburger { display: block; }
    }
  </style>
</head>
<body>

  <nav class="profil-nav">
    <div class="nav-container">
      <a href={profilHome} class="brand">
        <img src="https://sarjanakomputer.id/images/logo.png" alt="SKI Logo" />
        <div class="brand-text">
          <span class="brand-name">Sarjana<span>Komputer</span></span>
          <span class="brand-sub">Profil Resmi</span>
        </div>
      </a>
      
      <div class="d-flex align-items-center">
        <ul class="menu">
          {navLinks.map(link => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
        </ul>
        <a href={mainSite} class="btn-main-nav d-none d-sm-inline-flex">
          <i class="bi bi-house-door"></i> Home
        </a>
        <button class="profil-hamburger" id="profilHam">
          <i class="bi bi-list"></i>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobileMenuProfil" style="display:none; position:fixed; inset:0; background:#fff; z-index:2000; padding:2rem;">
     <div class="d-flex justify-content-between align-items-center mb-4">
        <span style="color:var(--dark); font-weight:800;">Menu Profil</span>
        <button id="closeMenuProfil" style="background:none; border:none; color:var(--dark); font-size:1.8rem;"><i class="bi bi-x-lg"></i></button>
     </div>
     <ul style="list-style:none; padding:0; display:flex; flex-direction:column; gap:0.7rem;">
        {navLinks.map(link => (
          <li><a href={link.href} class="mob-link-profil" style="color:var(--gray-700); font-weight:600; font-size:1.1rem; text-decoration:none; display:flex; align-items:center; gap:0.8rem; padding:0.4rem 0;"><i class={`bi ${link.icon}`}></i> {link.name}</a></li>
        ))}
        <li><hr style="border-color:#e2e8f0"></li>
        <li><a href={mainSite} style="color:var(--gray-400); text-decoration:none; font-size:0.9rem;"><i class="bi bi-arrow-left"></i> Kembali ke Website Utama</a></li>
     </ul>
  </div>

  <main>
    <slot />
  </main>

  <footer class="profil-footer">
    <div class="container">
      <p>&copy; 2026 <a href={mainSite}>Sarjana Komputer Indonesia</a>. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script is:inline>
    (function() {
      const ham = document.getElementById('profilHam');
      const close = document.getElementById('closeMenuProfil');
      const menu = document.getElementById('mobileMenuProfil');
      if(!ham || !menu || !close) return;
      
      ham.onclick = () => { menu.style.display = 'block'; document.body.style.overflow = 'hidden'; };
      close.onclick = () => { menu.style.display = 'none'; document.body.style.overflow = ''; };
      
      document.querySelectorAll('.mob-link-profil').forEach(l => {
        l.onclick = () => { menu.style.display = 'none'; document.body.style.overflow = ''; };
      });
    })();
  </script>
</body>
</html>
