---
import AcademyLayout from '../../../layouts/AcademyLayout.astro';
import { PB_URL } from '../../../utils/config.js';
import { marked } from 'marked';

const { slug } = Astro.params;
const url = 'https://cms.sarjanakomputer.id';
const res = await fetch(`${url}/api/collections/courses/records?filter=(slug='${slug}')`);
const data = await res.json();
const course = data.items && data.items.length > 0 ? data.items[0] : null;

if (!course) {
  return Astro.redirect('/academy');
}

const contentHtml = course.content ? marked.parse(course.content) : '';
---

<AcademyLayout title={`${course.title} | Sarjana Komputer Academy`} description={course.description} basePath="../..">
  <section class="section" style="padding-top: 6rem; padding-bottom: 4rem;">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/academy">Academy</a></li>
          <li class="breadcrumb-item"><a href="/academy#katalog">Course</a></li>
          <li class="breadcrumb-item active" aria-current="page">{course.title}</li>
        </ol>
      </nav>

      <div class="row g-4 mt-2">
        <div class="col-lg-8">
          <div class="card-custom p-4 p-md-5">
            <span class="badge bg-primary mb-3">{course.category}</span>
            <h1 class="mb-3" style="font-size: 2rem; font-weight: 800;">{course.title}</h1>
            <p class="lead text-muted mb-4">{course.description}</p>
            
            <div class="d-flex flex-wrap gap-4 mb-5 border-top border-bottom py-3">
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-bar-chart-fill text-primary" style="font-size: 1.5rem;"></i>
                <div>
                  <div style="font-size: 0.75rem; color: var(--gray-500); font-weight: 600;">Level</div>
                  <div style="font-weight: 600;">{course.level || 'All Levels'}</div>
                </div>
              </div>
              <div class="d-flex align-items-center gap-2">
                <i class="bi bi-clock text-primary" style="font-size: 1.5rem;"></i>
                <div>
                  <div style="font-size: 0.75rem; color: var(--gray-500); font-weight: 600;">Durasi</div>
                  <div style="font-weight: 600;">{course.duration || '-'}</div>
                </div>
              </div>
            </div>

            {course.content && (
              <div class="course-content mb-5">
                <h3 class="mb-4">Deskripsi Program</h3>
                <div class="prose" set:html={contentHtml} />
              </div>
            )}

            {course.modules && course.modules.length > 0 && (
              <div class="course-modules">
                <h3 class="mb-4">Silabus / Modul Pembelajaran</h3>
                <div class="accordion" id="modulesAccordion">
                  {course.modules.map((mod: any, index: number) => (
                    <div class="accordion-item mb-2" style="border: 1px solid var(--gray-200); border-radius: 8px; overflow: hidden;">
                      <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target={`#collapse${index}`} aria-expanded="false" aria-controls={`collapse${index}`} style="background: var(--gray-50); font-weight: 600;">
                          Modul {index + 1}: {mod.title}
                        </button>
                      </h2>
                      <div id={`collapse${index}`} class="accordion-collapse collapse" data-bs-parent="#modulesAccordion">
                        <div class="accordion-body">
                          <ul class="mb-0" style="padding-left: 1rem; color: var(--gray-600);">
                            {mod.topics && mod.topics.map((topic: string) => (
                              <li class="mb-1">{topic}</li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="col-lg-4">
          <div class="card-custom p-4 sticky-top" style="top: 100px;">
            <div class="card-img-wrapper mb-4 rounded overflow-hidden" style="position: relative; padding-top: 56.25%;">
              <img src={course.image ? `${PB_URL}/api/files/${course.collectionId}/${course.id}/${course.image}` : `https://placehold.co/600x340/312e5f/ffffff?text=${encodeURIComponent(course.title)}`} alt={course.title} style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <h3 class="text-primary fw-bold mb-4">{course.price ? `Rp ${course.price.toLocaleString('id-ID')}` : 'Gratis'}</h3>
            <a href="/academy#kelas" class="btn-primary-custom w-100 justify-content-center mb-3 py-2">Cek Jadwal Kelas</a>
            <a href="https://wa.me/6283134086899" target="_blank" class="btn btn-outline-secondary w-100 py-2" style="border-radius: 10px;">Hubungi Admin</a>
            
            <hr class="my-4" />
            <h6 class="mb-3 fw-bold">Benefit Program:</h6>
            <ul class="list-unstyled" style="font-size: 0.85rem; color: var(--gray-600);">
              <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i> Akses Modul Lengkap</li>
              <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i> Grup Diskusi Komunitas</li>
              <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i> Sertifikat Penyelesaian</li>
              <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i> Portfolio Project Real</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</AcademyLayout>
