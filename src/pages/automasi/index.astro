---
import Layout from '../../layouts/Layout.astro';
import { getAutomasiUrl } from '../../utils/routes.js';
---

<Layout title="Automasi & AI — Sarjana Komputer Indonesia" description="Automasi bisnis dengan AI — hemat 70% waktu operasional. Chatbot, document processing, workflow automation dari Sarjana Komputer Indonesia. Konsultasi gratis." canonical={getAutomasiUrl()} basePath=".." ogTitle="Automasi & AI — Sarjana Komputer Indonesia" ogDescription="Bebaskan tim Anda dari tugas manual berulang. Hemat 70% waktu operasional dengan solusi automasi cerdas dari Sarjana Komputer Indonesia. Chatbot, workflow, AI document processing — konsultasi gratis." ogImage="https://automasi.sarjanakomputer.id/images/automasi-og.jpg">
  <!-- HERO -->
  <section class="hero-section">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <div class="hero-badge"><i class="bi bi-robot"></i> Automasi & AI</div>
          <h1>Automasi Bisnis dengan Kecerdasan Buatan</h1>
          <p>Bebaskan tim Anda dari tugas manual berulang. Hemat 70% waktu operasional dengan solusi automasi cerdas dari Sarjana Komputer Indonesia.</p>
          <div class="d-flex flex-wrap gap-2 mt-3">
            <a href="#solusi" class="btn-primary-custom"><i class="bi bi-lightbulb"></i> Lihat Solusi</a>
            <a href="https://wa.me/6283134086899?text=Halo%20Sarjana%20Komputer%2C%20saya%20ingin%20konsultasi%20gratis%20tentang%20automasi%20bisnis" target="_blank" class="btn-outline-custom" style="border-color:rgba(255,255,255,0.2);color:rgba(255,255,255,0.7);"><i class="bi bi-whatsapp"></i> Konsultasi Gratis</a>
          </div>
        </div>
        <div class="col-lg-5 text-center d-none d-lg-block">
          <img src="../images/automasi-thumbnail.jpg" alt="Automasi Bisnis Sarjana Komputer Indonesia" class="hero-thumb img-fluid" style="border-radius:var(--radius);box-shadow:0 20px 60px rgba(0,0,0,0.3);max-height:400px;width:auto">
        </div>
      </div>
    </div>
  </section>

  <!-- MASALAH -->
  <section class="section" id="masalah">
    <div class="container">
      <div class="text-center">
        <div class="hero-badge" style="background:rgba(245,158,11,0.08);color:var(--accent);border-color:rgba(245,158,11,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-exclamation-triangle"></i> Masalah</div>
        <h2 class="section-title">Apakah Bisnis Anda Mengalami Ini?</h2>
        <p class="section-subtitle">Jika iya, saatnya beralih ke automasi — biarkan mesin yang bekerja, manusia yang berpikir</p>
      </div>
      <div class="row g-3">
        <div class="col-md-4">
          <div class="problem-card">
            <div class="icon" style="background:linear-gradient(135deg,#ef4444,#f87171)"><i class="bi bi-clock-history"></i></div>
            <h5>Proses Manual Memakan Waktu</h5>
            <p>Setiap hari staf Anda habiskan 3-4 jam untuk data entry, rekap laporan, dan approval manual. Waktu yang seharusnya untuk pertumbuhan bisnis.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="problem-card">
            <div class="icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-emoji-frown"></i></div>
            <h5>Human Error Mengintai</h5>
            <p>Satu angka salah input bisa menyebabkan laporan keuangan tidak balance, stok barang kacau, atau keputusan bisnis yang keliru.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="problem-card">
            <div class="icon" style="background:linear-gradient(135deg,#8b5cf6,#a78bfa)"><i class="bi bi-bar-chart-line"></i></div>
            <h5>Sulit Memonitor Kinerja</h5>
            <p>Data tersebar di 5-10 file Excel berbeda. Butuh 2-3 hari untuk kumpulin laporan. Keputusan strategis selalu terlambat.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUSI -->
  <section class="section section-alt" id="solusi">
    <div class="container">
      <div class="text-center">
        <div class="hero-badge" style="background:rgba(16,185,129,0.08);color:#10b981;border-color:rgba(16,185,129,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-check-circle"></i> Solusi</div>
        <h2 class="section-title">Solusi Automasi dari Kami</h2>
        <p class="section-subtitle">Tiga level solusi yang bisa disesuaikan dengan kebutuhan perusahaan Anda</p>
      </div>
      <div class="row g-3">
        <div class="col-md-4">
          <div class="solution-card">
            <div class="icon" style="background:linear-gradient(135deg,var(--primary),var(--primary-light))"><i class="bi bi-file-earmark-text"></i></div>
            <h5>Otomasi Administratif</h5>
            <p>Bebaskan staf dari tugas administrasi berulang. Absensi QR otomatis, surat menyurat digital, approval online, semuanya terekam rapi di dashboard.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="solution-card">
            <div class="icon" style="background:linear-gradient(135deg,#f59e0b,#f97316)"><i class="bi bi-graph-up-arrow"></i></div>
            <h5>Otomasi Operasional</h5>
            <p>Otomatiskan proses inti bisnis Anda. Laporan keuangan auto-generate, stok barang real-time, follow-up pelanggan otomatis via WA & email tanpa sentuh.</p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="solution-card">
            <div class="icon" style="background:linear-gradient(135deg,#8b5cf6,var(--secondary))"><i class="bi bi-cpu"></i></div>
            <h5>AI-Powered Automasi</h5>
            <p>Tingkatkan bisnis Anda dengan kecerdasan buatan. Chatbot customer service 24 jam, scan dokumen auto-fill, laporan langsung dari data mentah dalam Bahasa Indonesia.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PAKET & HARGA -->
  <section class="section" id="tier">
    <div class="container">
      <div class="text-center">
        <div class="hero-badge" style="background:rgba(49,46,95,0.08);color:var(--primary);border-color:rgba(49,46,95,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-layers"></i> Paket & Harga</div>
        <h2 class="section-title">Pilih Level Automasi yang Tepat</h2>
        <p class="section-subtitle">Dari UMKM hingga korporasi — semua bisa automasi dengan investasi yang terjangkau</p>
      </div>
      <div class="row g-3 justify-content-center">
        <div class="col-md-6 col-lg-4">
          <div class="tier-card">
            <div class="tier-icon">🥉</div>
            <h5>Bronze — Otomasi Dasar</h5>
            <div class="tier-price">Rp3-5jt <span>build + Rp500rb/bln</span></div>
            <p style="font-size:0.8rem;color:var(--gray-500);margin-bottom:1rem">Target: UMKM, toko kecil, jasa</p>
            <ul>
              <li><i class="bi bi-check-circle"></i> 1-2 proses otomasi</li>
              <li><i class="bi bi-check-circle"></i> Dashboard monitoring</li>
              <li><i class="bi bi-check-circle"></i> Support email</li>
              <li><i class="bi bi-check-circle"></i> Maintenance bulanan</li>
            </ul>
            <a href="https://wa.me/6283134086899?text=Halo%20Sarjana%20Komputer%2C%20saya%20tertarik%20paket%20Bronze%20Otomasi%20Dasar.%20Minta%20info%20lebih%20lanjut." target="_blank" class="btn-outline-custom" style="font-size:0.8rem;padding:0.4rem 1.2rem"><i class="bi bi-whatsapp"></i> Konsultasi Gratis</a>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="tier-card" style="border-color:var(--primary);box-shadow:0 0 0 2px var(--primary);position:relative">
            <div class="popular-badge" style="position:absolute;top:-0.75rem;left:50%;transform:translateX(-50%);padding:0.3rem 1rem;background:var(--gradient);color:white;border-radius:50px;font-size:0.7rem;font-weight:700">REKOMENDASI</div>
            <div class="tier-icon">🥈</div>
            <h5>Silver — Otomasi Bisnis</h5>
            <div class="tier-price">Rp8-15jt <span>build + Rp1-2jt/bln</span></div>
            <p style="font-size:0.8rem;color:var(--gray-500);margin-bottom:1rem">Target: Perusahaan menengah</p>
            <ul>
              <li><i class="bi bi-check-circle"></i> 3-5 proses otomasi + integrasi</li>
              <li><i class="bi bi-check-circle"></i> Dashboard + laporan otomatis</li>
              <li><i class="bi bi-check-circle"></i> Support WA/telepon prioritas</li>
              <li><i class="bi bi-check-circle"></i> Pelatihan staf</li>
              <li><i class="bi bi-check-circle"></i> SLA 2x24 jam</li>
            </ul>
            <a href="https://wa.me/6283134086899?text=Halo%20Sarjana%20Komputer%2C%20saya%20tertarik%20paket%20Silver%20Otomasi%20Bisnis.%20Minta%20info%20lebih%20lanjut." target="_blank" class="btn-primary-custom" style="font-size:0.8rem;padding:0.4rem 1.2rem"><i class="bi bi-whatsapp"></i> Pilih Paket Silver</a>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="tier-card">
            <div class="tier-icon">🥇</div>
            <h5>Gold — Enterprise AI</h5>
            <div class="tier-price">Custom <span>konsultasi</span></div>
            <p style="font-size:0.8rem;color:var(--gray-500);margin-bottom:1rem">Target: Pemerintah/korporasi</p>
            <ul>
              <li><i class="bi bi-check-circle"></i> Semua fitur Silver + AI</li>
              <li><i class="bi bi-check-circle"></i> AI chatbot / document processing</li>
              <li><i class="bi bi-check-circle"></i> Integrasi sistem existing</li>
              <li><i class="bi bi-check-circle"></i> Dedicated support</li>
              <li><i class="bi bi-check-circle"></i> SLA 1x24 jam prioritas</li>
            </ul>
            <a href="https://wa.me/6283134086899?text=Halo%20Sarjana%20Komputer%2C%20saya%20tertarik%20paket%20Gold%20Enterprise%20AI.%20Minta%20konsultasi." target="_blank" class="btn-outline-custom" style="font-size:0.8rem;padding:0.4rem 1.2rem"><i class="bi bi-whatsapp"></i> Hubungi Kami</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STUDI KASUS -->
  <section class="section section-alt" id="kasus">
    <div class="container">
      <div class="text-center">
        <div class="hero-badge" style="background:rgba(49,46,95,0.08);color:var(--primary);border-color:rgba(49,46,95,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-journal-text"></i> Studi Kasus</div>
        <h2 class="section-title">Dampak Nyata Automasi untuk Klien Kami</h2>
        <p class="section-subtitle">Efisiensi bukan teori — ini hasil yang sudah kami buktikan</p>
      </div>
      <div class="row g-3">
        <div class="col-md-6">
          <div class="case-study">
            <span class="tag">Otomasi Administratif</span>
            <h5 style="font-size:0.95rem;margin-bottom:0.3rem">Instansi Pemerintah — Automasi Surat Menyurat</h5>
            <p style="font-size:0.82rem;color:var(--gray-500);line-height:1.7">Sebelum: Setiap surat butuh 15-20 menit pembuatan + antar ruang untuk approval. Sesudah: Template digital, approval online via WA, 3 menit per surat. Efisiensi 80%. Biaya operasional turun drastis.</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="case-study">
            <span class="tag">AI-Powered</span>
            <h5 style="font-size:0.95rem;margin-bottom:0.3rem">Perusahaan Jasa — Chatbot Customer Service</h5>
            <p style="font-size:0.82rem;color:var(--gray-500);line-height:1.7">Sebelum: 5 orang CS kewalahan handle 300+ chat/hari. Sesudah: Chatbot AI jawab 70% pertanyaan otomatis 24 jam. Tim CS fokus ke pertanyaan kompleks. Kepuasan pelanggan naik 40%.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KUSTOMISASI & RISET -->
  <section class="section section-alt" id="kustom">
    <div class="container">
      <div class="text-center">
        <div class="hero-badge" style="background:rgba(245,158,11,0.08);color:var(--accent);border-color:rgba(245,158,11,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-sliders"></i> Kustom & Riset</div>
        <h2 class="section-title">Automasi yang Sesuai Kebutuhan Anda</h2>
        <p class="section-subtitle">Setiap bisnis unik — solusi automasi juga harus disesuaikan, bukan dipaksakan</p>
      </div>
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <div class="kustom-card">
            <div class="kustom-icon"><i class="bi bi-sliders"></i></div>
            <h5>Sesuaikan Sendiri Kebutuhan Anda</h5>
            <p>Tidak ada paket yang kaku. Setiap layanan automasi bisa dirancang khusus sesuai dengan kebutuhan bisnis Anda. Mulai dari proses yang ingin diotomatiskan, jumlah pengguna, hingga tingkat kompleksitas — semua bisa disesuaikan. Tim teknis kami akan mendampingi Anda menentukan spesifikasi yang tepat, sehingga Anda tidak membayar untuk fitur yang tidak diperlukan.</p>
            <p style="margin-top:0.5rem;font-size:0.85rem;color:var(--primary);font-weight:600"><i class="bi bi-check-circle-fill"></i> Pilih sendiri proses yang mau diotomatiskan</p>
            <p style="font-size:0.85rem;color:var(--primary);font-weight:600"><i class="bi bi-check-circle-fill"></i> Tentukan budget sesuai kemampuan</p>
            <p style="font-size:0.85rem;color:var(--primary);font-weight:600"><i class="bi bi-check-circle-fill"></i> Tambah atau kurangi fitur kapan saja</p>
          </div>
        </div>
        <div class="col-md-6">
          <div class="kustom-card">
            <div class="kustom-icon" style="background:linear-gradient(135deg,#f59e0b,#f97316)"><i class="bi bi-search-heart"></i></div>
            <h5>Riset & Analisis Kebutuhan Gratis</h5>
            <p>Sebelum menentukan solusi, kami lakukan riset mendalam terlebih dahulu. Klien cukup menjelaskan topik masalah yang dihadapi — misalnya: <em>"Saya kesulitan merekap laporan keuangan dari 3 toko berbeda"</em> atau <em>"Staf saya kewalahan handle 500 chat pelanggan per hari"</em>. Dari situ kami analisa pola masalahnya, lalu rekomendasikan solusi automasi yang paling tepat. <strong>Riset pertama GRATIS tanpa komitmen.</strong></p>
            <a href="https://wa.me/6283134086899?text=Halo%20Sarjana%20Komputer%2C%20saya%20mau%20konsultasi%20gratis%20riset%20kebutuhan%20automasi%20bisnis" target="_blank" class="btn-primary-custom" style="font-size:0.85rem;padding:0.5rem 1.4rem;display:inline-flex;margin-top:0.5rem"><i class="bi bi-whatsapp"></i> Konsultasi Gratis Sekarang</a>
          </div>
        </div>
      </div>

      <!-- TOPIK MASALAH -->
      <div class="text-center mt-5">
        <div class="hero-badge" style="background:rgba(49,46,95,0.08);color:var(--primary);border-color:rgba(49,46,95,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-tags"></i> Topik Masalah</div>
        <h2 class="section-title" style="font-size:1.5rem">Topik Masalah yang Sering Kami Tangani</h2>
        <p class="section-subtitle">Pilih topik yang paling sesuai dengan kondisi bisnis Anda — atau ceritakan masalah unik Anda</p>
      </div>
      <div class="row g-3">
        <div class="col-md-6 col-lg-4">
          <div class="topik-card">
            <div class="topik-icon" style="background:linear-gradient(135deg,#10b981,#34d399)"><i class="bi bi-currency-dollar"></i></div>
            <h5>Keuangan & Akuntansi</h5>
            <p>Rekonsiliasi bank manual, laporan keuangan telat, invoice belum tertagih, penggajian ribet.</p>
            <span class="topik-solusi">Solusi: Automasi laporan keuangan, invoice reminder otomatis, integrasi payment gateway.</span>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="topik-card">
            <div class="topik-icon" style="background:linear-gradient(135deg,#3b82f6,#60a5fa)"><i class="bi bi-box-seam"></i></div>
            <h5>Operasional & Inventory</h5>
            <p>Stok barang sering kehabisan tanpa tahu, order masuk campur aduk, pengiriman tidak terpantau.</p>
            <span class="topik-solusi">Solusi: Inventory real-time, auto reorder, tracking pengiriman otomatis.</span>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="topik-card">
            <div class="topik-icon" style="background:linear-gradient(135deg,#8b5cf6,#a78bfa)"><i class="bi bi-headset"></i></div>
            <h5>Customer Service</h5>
            <p>CS kewalahan, pelanggan lama menunggu, banyak chat tidak terbalas, jam operasional terbatas.</p>
            <span class="topik-solusi">Solusi: Chatbot AI 24 jam, auto-reply pintar, routing ke CS manusia untuk kasus kompleks.</span>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="topik-card">
            <div class="topik-icon" style="background:linear-gradient(135deg,#f59e0b,#fbbf24)"><i class="bi bi-people"></i></div>
            <h5>Administrasi & HR</h5>
            <p>Absensi manual, surat menyurat lama, approval cuti/reimbursement ribet, data karyawan tercecer.</p>
            <span class="topik-solusi">Solusi: HRIS sederhana, e-office, approval workflow digital, absensi QR.</span>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="topik-card">
            <div class="topik-icon" style="background:linear-gradient(135deg,#ef4444,#f87171)"><i class="bi bi-megaphone"></i></div>
            <h5>Pemasaran & Sales</h5>
            <p>Follow-up pelanggan tidak konsisten, lead hilang, campaign manual, ROI tidak terukur.</p>
            <span class="topik-solusi">Solusi: CRM automasi, WA blast terjadwal, pipeline tracking, auto-reminder pelanggan.</span>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="topik-card">
            <div class="topik-icon" style="background:linear-gradient(135deg,#312E5F,#5C5991)"><i class="bi bi-bar-chart"></i></div>
            <h5>Laporan & Dashboard</h5>
            <p>Data dari 5 sistem berbeda, butuh 2 hari bikin laporan, pimpinan selalu nunggu data.</p>
            <span class="topik-solusi">Solusi: Dashboard real-time, laporan auto-generate, export PDF/Excel satu klik.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CARA KERJA -->
  <section class="section" id="cara-kerja">
    <div class="container">
      <div class="text-center">
        <div class="hero-badge" style="background:rgba(49,46,95,0.08);color:var(--primary);border-color:rgba(49,46,95,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-gear"></i> Proses</div>
        <h2 class="section-title">Bagaimana Kami Bekerja?</h2>
        <p class="section-subtitle">Empat langkah sederhana menuju bisnis yang lebih efisien</p>
      </div>
      <div class="row g-3">
        <div class="col-md-6 col-lg-3">
          <div class="problem-card" style="text-align:center">
            <div class="icon" style="background:var(--gradient);width:64px;height:64px;border-radius:50%"><i class="bi bi-chat-dots" style="font-size:1.5rem"></i></div>
            <h5 style="font-size:1rem">1. Konsultasi Gratis</h5>
            <p style="font-size:0.82rem;color:var(--gray-500);margin:0">Hubungi kami via WA atau temu langsung. Kita analisa masalah operasional dan kebutuhan bisnis Anda.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="problem-card" style="text-align:center">
            <div class="icon" style="background:var(--gradient);width:64px;height:64px;border-radius:50%"><i class="bi bi-file-earmark-text" style="font-size:1.5rem"></i></div>
            <h5 style="font-size:1rem">2. Proposal Solusi</h5>
            <p style="font-size:0.82rem;color:var(--gray-500);margin:0">Kami rancang sistem automasi yang tepat untuk Anda, lengkap dengan RAB jelas tanpa biaya tersembunyi.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="problem-card" style="text-align:center">
            <div class="icon" style="background:var(--gradient);width:64px;height:64px;border-radius:50%"><i class="bi bi-code-slash" style="font-size:1.5rem"></i></div>
            <h5 style="font-size:1rem">3. Development & Integrasi</h5>
            <p style="font-size:0.82rem;color:var(--gray-500);margin:0">Tim kami bangun sistem dan integrasikan dengan software existing Anda. Progress laporan berkala.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="problem-card" style="text-align:center">
            <div class="icon" style="background:var(--gradient);width:64px;height:64px;border-radius:50%"><i class="bi bi-rocket-takeoff" style="font-size:1.5rem"></i></div>
            <h5 style="font-size:1rem">4. Go Live + Training</h5>
            <p style="font-size:0.82rem;color:var(--gray-500);margin:0">Sistem jalan, staf dilatih, kami pantau 7 hari pertama. Anda dapat support penuh selama maintenance.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DOWNLOAD PDF -->
  <section class="section" id="download">
    <div class="container">
      <div class="text-center">
        <div class="hero-badge" style="background:rgba(220,38,38,0.08);color:#dc2626;border-color:rgba(220,38,38,0.15);display:inline-flex;margin-bottom:1rem"><i class="bi bi-filetype-pdf"></i> Download</div>
        <h2 class="section-title">Unduh Proposal Lengkap</h2>
        <p class="section-subtitle">Bawa proposal ini ke atasan atau instansi Anda — format PDF rapi siap cetak</p>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="download-card">
            <div class="row align-items-center">
              <div class="col-md-4 text-center">
                <i class="bi bi-filetype-pdf" style="font-size:5rem;color:#dc2626"></i>
